{
  "schemaVersion": 1,
  "capabilities": [
    {
      "id": "creative-brief",
      "name": "创意方案",
      "transport": "http",
      "endpoint": "/v1/creative/brief",
      "method": "POST",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "requires": [
        "DEEPSEEK_API_KEY"
      ],
      "validation": "local-mock-only"
    },
    {
      "id": "text-generation-task",
      "name": "文字生成与修改任务",
      "transport": "http",
      "endpoint": "/v1/tasks",
      "method": "POST",
      "kinds": [
        "creative",
        "content",
        "art",
        "objects",
        "novel"
      ],
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "requires": [
        "DEEPSEEK_API_KEY"
      ],
      "validation": "local-mock-only"
    },
    {
      "id": "image-generation-task",
      "name": "概念图与封面生成、原图编辑",
      "transport": "http",
      "endpoint": "/v1/tasks",
      "method": "POST",
      "kinds": [
        "image",
        "cover",
        "video-frame"
      ],
      "providers": [
        "workbuddy",
        "external"
      ],
      "configuration": {
        "workbuddy": "WORKBUDDY_ACCESS_TOKEN or explicit manual handoff",
        "external": "IMAGE_API_BASE_URL, IMAGE_API_KEY, IMAGE_API_MODEL"
      },
      "validation": "local-mock-only"
    },
    {
      "id": "workspace-storage",
      "name": "项目与媒体保存",
      "transport": "http",
      "endpoint": "/v1/workspace",
      "methods": [
        "GET",
        "PUT"
      ],
      "validation": "local-tested"
    },
    {
      "id": "video-generation-task",
      "name": "单镜头视频提示词与生成；保留原分镜、旁白与合成",
      "transport": "http",
      "endpoint": "/v1/tasks",
      "method": "POST",
      "kinds": [
        "video-plan",
        "video-shot",
        "video-audio",
        "video-compose"
      ],
      "providers": [
        "deepseek",
        "workbuddy",
        "runway-gen4.5",
        "local-ffmpeg"
      ],
      "validation": "local-files-and-mock-tested; real-provider-not-verified"
    },
    {
      "id": "website-generation-task",
      "name": "网站生成提示词与素材包；旧模板重建兼容",
      "transport": "http",
      "endpoint": "/v1/tasks",
      "method": "POST",
      "kinds": [
        "website",
        "website-build"
      ],
      "providers": [
        "local-prompt-harness",
        "workbuddy-handoff",
        "legacy-static-compiler"
      ],
      "validation": "local-prompt-and-files-tested; external-agent-website-not-verified"
    },
    {
      "id": "delivery-files",
      "name": "媒体文件导入、成品下载与分段播放",
      "transport": "http",
      "endpoint": "/v1/files/:fileId",
      "validation": "local-tested",
      "method": "GET",
      "uploadEndpoints": [
        "/v1/files/mp4",
        "/v1/files/wav"
      ],
      "restoreEndpoint": "/v1/files/restore/:fileId"
    },
    {
      "id": "workbuddy-core-mcp",
      "name": "外部 agent 项目、提示词与媒体交接",
      "transport": "stdio-mcp",
      "entrypoint": "scripts/workbench-mcp.mjs",
      "runtimeEndpoint": "/v1/core/:tool",
      "tools": [
        "knowledge_search",
        "knowledge_apply",
        "workflow_get",
        "workflow_update",
        "website_source_import",
        "prompt_prepare",
        "workbench_status",
        "project_list",
        "project_get",
        "project_create",
        "project_update",
        "task_start",
        "task_list",
        "task_get",
        "task_cancel",
        "task_adopt",
        "media_import",
        "project_deliver",
        "task_dismiss",
        "workspace_recover",
        "storage_cleanup",
        "video_frame_fit",
        "workbench_call_json",
        "task_complete_handoff",
        "theme_asset_list",
        "theme_asset_apply",
        "image_select",
        "website_run",
        "website_complete"
      ],
      "skills": [
        "workbench/skills/creativity-project",
        "workbench/skills/creativity-media"
      ],
      "configuration": "npm run workbench:setup",
      "validation": "local-continuous-website-tests; WorkBuddy-client-retest-required",
      "protocolVersion": 10,
      "skillVersion": "0.7.0"
    },
    {
      "id": "service-settings",
      "name": "本机 API 与默认生成服务配置",
      "transport": "http",
      "endpoint": "/v1/settings",
      "methods": [
        "GET",
        "PUT"
      ],
      "validation": "local-tested; credentials-not-returned"
    },
    {
      "id": "workspace-recovery",
      "name": "检查并恢复上一版工作区快照",
      "transport": "http",
      "endpoint": "/v1/recovery",
      "method": "POST",
      "validation": "local-tested; explicit-recovery-token-required"
    },
    {
      "id": "continuous-workflow",
      "name": "完整正文、已采用媒体与多来源资料向网站交接",
      "transport": "http",
      "endpoint": "/v1/core/workflow_get",
      "mutationEndpoint": "/v1/core/workflow_update",
      "protocolVersion": 8,
      "validation": "local-workflow-and-stdio-tested; real-provider-not-verified"
    },
    {
      "id": "website-source",
      "name": "真实网站源码候选、采用与静态隔离预览",
      "transport": "http",
      "endpoint": "/v1/files/website-source",
      "method": "POST",
      "previewEndpoint": "/v1/source-preview/:fileId/:path",
      "validation": "local-zip-and-http-tested; external-agent-build-not-verified"
    },
    {
      "id": "design-package",
      "name": "3D 前期与跨媒介设计资料包",
      "transport": "http",
      "endpoint": "/v1/tasks",
      "method": "POST",
      "kinds": [
        "design-package"
      ],
      "validation": "local-files-tested; no-3d-generation"
    },
    {
      "id": "lingnan-knowledge",
      "name": "可追溯岭南文化知识选择与生成依据",
      "transport": "http",
      "endpoint": "/v1/core/knowledge_search",
      "mutationEndpoint": "/v1/core/knowledge_apply",
      "version": "2026-09-10.1",
      "entryCount": 11,
      "validation": "sources-reviewed; local-reference-and-generation-input-tested; generated-cultural-quality-not-verified"
    },
    {
      "id": "lingnan-visual-assets",
      "name": "可直接使用的岭南原创视觉素材",
      "transport": "http",
      "endpoint": "/v1/core/theme_asset_list",
      "mutationEndpoint": "/v1/core/theme_asset_apply",
      "version": "lingnan-visual-2026-09-10.1",
      "entryCount": 6,
      "formats": [
        "png",
        "svg",
        "webp-thumbnail"
      ],
      "validation": "local-files-and-core-selected-bundle-tested; original-illustration-not-historical-reconstruction"
    },
    {
      "id": "image-result-sync",
      "name": "图片任务结果、候选与选用状态同步",
      "transport": "http",
      "endpoint": "/v1/core/image_select",
      "protocolVersion": 9,
      "validation": "local-runtime-http-and-browser-tested; remote-WorkBuddy-client-retest-required"
    },
    {
      "id": "website-studio",
      "name": "一次目标、连续网站制作与源码回传",
      "transport": "http",
      "endpoint": "/v1/core/website_run",
      "completion": "/v1/core/website_complete",
      "protocolVersion": 10,
      "validation": "local-integration-tested; WorkBuddy-client-retest-required",
      "scope": "自动准备资料、网站原任务交接、静态源码初稿、限定范围修改与用户选用；依赖 WorkBuddy 实际执行，不提供业务后台或云发布"
    }
  ],
  "editorModules": []
}
