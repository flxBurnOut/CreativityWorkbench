{
  "name": "app-scaffold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./lib/workbench/temp-env.mjs scripts/dev.mjs",
    "dev:web": "node --import ./lib/workbench/temp-env.mjs node_modules/vinext/dist/cli.js dev --port 3001",
    "build": "node --import ./lib/workbench/temp-env.mjs node_modules/vinext/dist/cli.js build",
    "start": "node --import ./lib/workbench/temp-env.mjs node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json",
    "workbench": "node --import ./lib/workbench/temp-env.mjs scripts/workbench.mjs",
    "workbench:http": "node --import ./lib/workbench/temp-env.mjs scripts/workbench-http.mjs",
    "workbench:mcp": "node --import ./lib/workbench/temp-env.mjs scripts/workbench-mcp.mjs",
    "workbench:setup": "node --import ./lib/workbench/temp-env.mjs scripts/workbench-setup.mjs",
    "test": "node --import ./lib/workbench/temp-env.mjs --experimental-strip-types --test --test-concurrency=2 tests/*.test.mjs",
    "lint": "node --import ./lib/workbench/temp-env.mjs node_modules/oxlint/bin/oxlint",
    "typecheck": "node --import ./lib/workbench/temp-env.mjs node_modules/typescript/bin/tsc --noEmit --incremental false",
    "assets:theme": "node --import ./lib/workbench/temp-env.mjs scripts/build-theme-assets.mjs",
    "demo:tourism": "node --import ./lib/workbench/temp-env.mjs scripts/demo-tourism.mjs",
    "test:memory": "node --import ./lib/workbench/temp-env.mjs --expose-gc scripts/verify-memory.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.4",
    "three": "0.186.0",
    "vinext": "1.0.0-beta.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
