# Copy to .env.local, fill locally, then restart npm run dev.
# Server-only. Never prefix this variable with NEXT_PUBLIC_ or VITE_.
DEEPSEEK_API_KEY=

# Default image provider. Choose workbuddy or external in the page for each request.
WORKBENCH_IMAGE_PROVIDER=workbuddy
# WorkBuddy Open Platform OAuth access token with user.localassistant.invokable.
# WorkBuddy must run on this computer and have access to the project data directory.
# If blank, the page offers a request to copy into WorkBuddy manually.
# Core MCP uses the current WorkBuddy conversation's file handoff; it never dispatches
# another message to WorkBuddy and does not require this token.
WORKBUDDY_ACCESS_TOKEN=

# Optional external Images API compatible with generations + multipart edits.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_API_MODEL=gpt-image-2

# Video: WorkBuddy MP4/WAV handoff or the documented Runway Gen-4.5 protocol.
VIDEO_PROVIDER=workbuddy
VIDEO_API_BASE_URL=https://api.dev.runwayml.com/v1
VIDEO_API_KEY=
# Additional exact HTTPS output CDN hostnames, comma separated; never include a URL.
# VIDEO_OUTPUT_HOSTS=
# Optional replacement binaries; defaults use the bundled npm binaries.
# FFMPEG_PATH=
# FFPROBE_PATH=

# Optional absolute local data directory. Default: <project>/work/data
# WORKBENCH_DATA_DIR=
# If changing the Runtime port, set both values and restart the whole dev service.
# WORKBENCH_RUNTIME_PORT=8791
# WORKBENCH_RUNTIME_URL=http://127.0.0.1:8791
# MCP setup: npm run workbench:setup (generates local ZIP skills and mcp.json;
# does not install them or modify WorkBuddy's existing configuration).
